# =============================================================================
# Local development override (x86 without NVIDIA runtime, without CSI/Argus).
#
# This file is loaded automatically by docker compose alongside
# docker-compose.yml and disables GPU-, Argus- and CSI-specific settings.
#
# On the Jetson: delete or rename this file
#   (mv docker-compose.override.yml docker-compose.override.yml.disabled)
# =============================================================================

services:
  home-monitoring:
    # runtime: nvidia is set in the base file; run without GPU here.
    runtime: ""
    # The base file uses network_mode: host (Jetson, IPv6-only). On the dev
    # machine use bridge networking + port mapping again.
    network_mode: bridge
    ports:
      - "${HOME_MONITOR_PORT:-8080}:8080"
    environment:
      - NVIDIA_VISIBLE_DEVICES=
      - NVIDIA_DRIVER_CAPABILITIES=
      - PYTHONUNBUFFERED=1
      - TZ=${TZ:-Europe/Berlin}
    # Adjust the video device for the dev machine (e.g. /dev/video0,
    # /dev/video6, ...). !override completely replaces the device list from
    # docker-compose.yml (no nvhost devices on x86).
    devices: !override
      - /dev/video0:/dev/video0
    # Volumes without Argus socket (does not exist on x86).
    volumes: !override
      - ${RECORDINGS_HOST_DIR:-/mnt/ssd/recordings}:/recordings:rw
      - ./models:/app/models:rw
