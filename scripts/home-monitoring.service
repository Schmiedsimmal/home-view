[Unit]
Description=Home Monitoring Docker Compose Stack
# Start after Docker so the containers come up.
After=docker.service
Requires=docker.service
# Wait briefly so USB devices (camera) are detected after boot.
# Without this the container could start before /dev/video0 is available.

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust the repo path if it is not /home/simon/git/home-monitoring
WorkingDirectory=/home/simon/git/home-monitoring
# Wait 5 seconds so USB devices settle.
ExecStartPre=/bin/sleep 5
# Compose as plugin ("docker compose") or standalone ("docker-compose").
ExecStart=/bin/bash -c 'docker compose up -d || docker-compose up -d'
ExecStop=/bin/bash -c 'docker compose stop || docker-compose stop'
# Do not retry endlessly on errors (Docker restarts containers itself).
Restart=no

[Install]
WantedBy=multi-user.target
