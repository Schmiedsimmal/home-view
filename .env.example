# =============================================================================
# Home Monitoring - zentrale Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# =============================================================================

# --- Allgemein ----------------------------------------------------------------
# TZ fuer Logs und Zeitstempel
TZ=Europe/Berlin

# --- Web-UI -------------------------------------------------------------------
# Port der Web-UI (Login, Live-Stream, Aufnahmen)
HOME_MONITOR_PORT=8080
# Passwort fuer die Web-UI (Login). Unbedingt aendern!
WEB_PASSWORD=changeme
# Secret zur Signierung der Session-Cookies. Zufallstext verwenden
# (z.B. `openssl rand -hex 32`).
WEB_SECRET=change-me-too

# --- Kamera -------------------------------------------------------------------
# Host-Video-Geraet (USB-Webcam). Wird als /dev/video0 in den Container gemappt.
# Pruefen mit: ls /dev/video*  bzw.  v4l2-ctl --list-devices
VIDEO_DEVICE=/dev/video0
# Kamera-Backend:
#   auto    - nvargus (CSI) wenn Argus-Socket vorhanden, sonst usb
#   nvargus - CSI-Kamera via GStreamer/nvarguscamerasrc (Jetson, Flachband-Kabel)
#   usb     - USB-Webcam via OpenCV VideoCapture
CAMERA_BACKEND=auto
# Kamera-Quelle. Bei backend=usb: "usb:0" (=/dev/video0), "rtsp://..." oder Pfad.
# Bei backend=nvargus: wird ignoriert (IMX219 o.ae. automatisch erkannt).
CAMERA_SOURCE=usb:0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15

# --- Live-Stream (MJPEG) ------------------------------------------------------
# JPEG-Qualitaet des Streams (1-100)
STREAM_JPEG_QUALITY=80
# Maximale Stream-Framerate (Frames pro Sekunde), unabhaengig von CAMERA_FPS
STREAM_MAX_FPS=15

# --- Objekterkennung (YOLOv8, optional) ---------------------------------------
# true: YOLO-Detektor laeuft 24/7 (GPU via cv2.dnn). false: nur Bewegung.
DETECTOR_ENABLED=true
# Inferenz-Rate in Frames pro Sekunde (Jetson Nano: 5 ist ein guter Kompromiss)
DETECT_FPS=5
# COCO-Klassen-IDs, komma-separiert. 0=person, 16=dog. Leer = alle Klassen.
DETECT_CLASSES=0,16
# ONNX-Modell. Liegt im ./models-Verzeichnis (Host) -> /app/models (Container).
# Export: `yolo export model=yolov8n.pt format=onnx imgsz=640`
YOLO_MODEL=yolov8n.onnx
# Confidence-Threshold (0.0 - 1.0)
YOLO_CONF_THRESHOLD=0.4
# NMS-Threshold (0.0 - 1.0)
YOLO_NMS_THRESHOLD=0.45
# Device: onnxruntime laeuft aktuell CPU-only ("auto"/"cpu" identisch).
YOLO_DEVICE=auto
# Input-Groesse des ONNX-Modells (quadratisch, muss zum Export passen)
YOLO_IMG_SIZE=640
# Bounding-Boxes + Labels im Live-Stream einzeichnen
DETECTION_OVERLAY=true

# --- Bewegungserkennung (ohne ML) --------------------------------------------
# true: Frame-Differenz laeuft 24/7 (CPU, sehr billig)
MOTION_ENABLED=true
# Pruefrate in Frames pro Sekunde
MOTION_FPS=5
# Pixel-Schwellenwert fuer absdiff (0-255). Hoeher = unempfindlicher.
MOTION_THRESHOLD=30
# Minimale bewegte Flaeche in Pixeln (downskaliertes 320x180-Bild)
MOTION_MIN_AREA=2000

# --- Aufzeichnung ----------------------------------------------------------------
# true: Ereignis-Aufzeichnung ist aktiv
RECORD_ENABLED=true
# Trigger fuer Aufzeichnung:
#   motion        - nur bei Bewegung
#   dog           - nur bei Hund-Erkennung
#   motion_or_dog - bei Bewegung ODER Hund (Default)
#   always        - dauerhaft aufzeichnen (solange Kamera laeuft)
RECORD_TRIGGER=motion_or_dog
# Aufzeichnungs-Framerate
RECORD_FPS=10
# Laenge eines MP4-Segments in Sekunden (laengere Ereignisse werden gesplittet)
RECORD_SEGMENT_S=300
# Aufnahme laeuft weiter solange ein Trigger feuert; Stop erst nach dieser
# Zeit (Sekunden) ohne Trigger.
RECORD_COOLDOWN_S=15
# Minimale Aufnahmedauer in Sekunden (verhindert 1-Frame-Dateien)
RECORD_MIN_S=5
# Aufnahmen aelter als diese Anzahl Tage automatisch loeschen
RECORD_RETENTION_DAYS=7
# Loescht zusaetzlich aelteste Aufnahmen, wenn die SSD zu diesem
# Fuellegrad (Prozent) voll ist
RECORD_MAX_DISK_PERCENT=80
# Host-Pfad der Aufnahmen (muss auf dem Jetson gemountet sein!)
RECORDINGS_HOST_DIR=/mnt/ssd/recordings
# ffmpeg-Encoding
FFMPEG_PRESET=ultrafast
FFMPEG_CRF=23

# --- Benachrichtigung (ntfy.sh) ----------------------------------------------
# true: Push-Benachrichtigung bei Hund-Erkennung
NOTIFY_ENABLED=true
# ntfy-Topic (z.B. mein-hund-monitor-xyz). Unbedingt einen eindeutigen Topic waehlen.
NOTIFY_NTFY_TOPIC=
# ntfy-Server (Default: oeffentlicher ntfy.sh)
NOTIFY_NTFY_SERVER=https://ntfy.sh
# Mindestabstand zwischen Benachrichtigungen in Sekunden (Spam-Schutz)
NOTIFY_COOLDOWN_S=300
# true: aktuelles Kamera-Bild als Anhang mitschicken
NOTIFY_ATTACH_IMAGE=true
