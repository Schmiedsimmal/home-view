# =============================================================================
# Home Monitoring - central configuration
# Copy this file to .env and adjust the values.
# =============================================================================

# --- General ------------------------------------------------------------------
# TZ for logs and timestamps
TZ=Europe/Berlin

# --- Web UI -------------------------------------------------------------------
# Port of the web UI (login, live stream, recordings)
HOME_MONITOR_PORT=8080
# Password for the web UI (login). Be sure to change it!
WEB_PASSWORD=changeme
# Secret for signing the session cookies. Use random text
# (e.g. `openssl rand -hex 32`).
WEB_SECRET=change-me-too

# --- Camera -------------------------------------------------------------------
# Host video device (USB webcam). Mapped into the container as /dev/video0.
# Check with: ls /dev/video*  or  v4l2-ctl --list-devices
VIDEO_DEVICE=/dev/video0
# Camera backend:
#   auto    - nvargus (CSI) if the Argus socket exists, otherwise usb
#   nvargus - CSI camera via GStreamer/nvarguscamerasrc (Jetson, flat ribbon cable)
#   usb     - USB webcam via OpenCV VideoCapture
CAMERA_BACKEND=auto
# Camera source. With backend=usb: "usb:0" (=/dev/video0), "rtsp://..." or a path.
# With backend=nvargus: ignored (IMX219 etc. detected automatically).
CAMERA_SOURCE=usb:0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15

# --- Live stream (MJPEG) ------------------------------------------------------
# JPEG quality of the stream (1-100)
STREAM_JPEG_QUALITY=80
# Maximum stream frame rate (frames per second), independent of CAMERA_FPS
STREAM_MAX_FPS=15

# --- Object detection (YOLOv8, optional) ---------------------------------------
# true: YOLO detector runs 24/7 (GPU via cv2.dnn). false: motion only.
DETECTOR_ENABLED=true
# Inference rate in frames per second (Jetson Nano CPU: 2 is realistic,
# ~0.6 s per frame at 320px)
DETECT_FPS=5
# COCO class IDs, comma-separated. 0=person, 16=dog. Empty = all classes.
DETECT_CLASSES=0,16
# ONNX model. Lives in the ./models directory (host) -> /app/models (container).
# Export: `yolo export model=yolov8n.pt format=onnx imgsz=320`
# YOLO_MODEL=yolov8n-320.onnx
# TorchScript model (GPU via PyTorch/CUDA, ~20 FPS on the Jetson Nano).
# Export: `yolo export model=yolov8n.pt format=torchscript imgsz=320`
# NOTE: TorchScript is tied to the torch version — the bundled
# yolov8n.torchscript was exported with torch 1.10 (matches the Jetson image).
YOLO_MODEL=yolov8n.torchscript
# Confidence threshold (0.0 - 1.0)
YOLO_CONF_THRESHOLD=0.5
# NMS threshold (0.0 - 1.0)
YOLO_NMS_THRESHOLD=0.45
# Device: onnxruntime currently runs CPU-only ("auto"/"cpu" identical).
YOLO_DEVICE=auto
# Input size of the ONNX model (square, must match the export)
YOLO_IMG_SIZE=320
# Draw bounding boxes + labels in the live stream
DETECTION_OVERLAY=true

# --- Motion detection (no ML) ---------------------------------------------------
# true: frame differencing runs 24/7 (CPU, very cheap)
MOTION_ENABLED=true
# Check rate in frames per second
MOTION_FPS=5
# Pixel threshold for absdiff (0-255). Higher = less sensitive.
MOTION_THRESHOLD=30
# Minimum moved area in pixels (downscaled 320x180 image)
MOTION_MIN_AREA=2000

# --- Recording ------------------------------------------------------------------
# true: event recording is active
RECORD_ENABLED=true
# Trigger for recording:
#   motion        - only on motion
#   dog           - only on dog detection
#   motion_or_dog - on motion OR dog (default)
#   always        - record continuously (as long as the camera runs)
RECORD_TRIGGER=motion_or_dog
# Recording frame rate
RECORD_FPS=10
# Length of an MP4 segment in seconds (longer events are split)
RECORD_SEGMENT_S=300
# Recording continues while a trigger fires; stop only after this
# time (seconds) without a trigger.
RECORD_COOLDOWN_S=15
# Minimum recording duration in seconds (prevents 1-frame files)
RECORD_MIN_S=5
# Dog must be detected continuously this long before recording starts [s]
RECORD_DOG_MIN_S=3
# Automatically delete recordings older than this many days
RECORD_RETENTION_DAYS=7
# Additionally delete oldest recordings when the SSD is this
# full (percent)
RECORD_MAX_DISK_PERCENT=80
# Host path of the recordings (must be mounted on the Jetson!)
# e.g. external SSD under /mnt/ssd/recordings or USB stick under /mnt/usb/recordings
RECORDINGS_HOST_DIR=/mnt/recordings
# ffmpeg encoding
FFMPEG_PRESET=ultrafast
FFMPEG_CRF=23

# --- Notification (ntfy.sh) -----------------------------------------------------
# true: push notification on dog detection
NOTIFY_ENABLED=true
# ntfy topic (e.g. my-dog-monitor-xyz). Be sure to choose a unique topic.
NOTIFY_NTFY_TOPIC=
# ntfy server (default: public ntfy.sh)
NOTIFY_NTFY_SERVER=https://ntfy.sh
# Minimum interval between notifications in seconds (spam protection)
NOTIFY_COOLDOWN_S=300
# true: attach the current camera image
NOTIFY_ATTACH_IMAGE=true
